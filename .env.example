# Variables globales opcionales para desarrollo local sin Docker.
# Con docker-compose, cada servicio ya trae sus valores por defecto
# en docker-compose.yml — este archivo es solo referencia.

REDIS_URL=redis://localhost:6379/0
STEP_DELAY_MS=3000

ACCOUNTS_URL=http://localhost:8001
RISK_URL=http://localhost:8002
CLEARING_URL=http://localhost:8003
PREFECT_API_URL=http://localhost:4200
