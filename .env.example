# Variables globales opcionales para desarrollo local sin Docker.
# Con docker-compose, cada servicio ya trae sus valores por defecto
# en docker-compose.yml — este archivo es solo referencia.

REDIS_URL=redis://localhost:6379/0
STEP_DELAY_MS=3000

ACCOUNTS_URL=http://localhost:8001
RISK_URL=http://localhost:8002
CLEARING_URL=http://localhost:8003
PREFECT_API_URL=http://localhost:4200

# Copiar este archivo a `.env` en la raíz del repo (docker-compose lo lee
# automáticamente) y completar con la connection string real de cada
# proyecto de Supabase — ver el .env.example de cada servicio y correr su
# schema.sql contra ese proyecto antes de levantar el stack.
#
# Usar el "Connection pooling" (Transaction pooler, puerto 6543) del
# dashboard de Supabase, NO la conexión directa "db.xxxxx.supabase.co" —
# esa resuelve solo a IPv6 y los contenedores de Docker Desktop no tienen
# salida IPv6, así que la conexión directa falla desde dentro de Docker
# aunque la contraseña esté bien. El usuario del pooler es
# postgres.<project-ref>, no solo "postgres".
ACCOUNTS_DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
RISK_DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
CLEARING_DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Bitácora de auditoría durable (common/status_store.py,
# common/schema_bitacora.sql) — correr ese schema.sql una vez, crear un rol
# con permisos SOLO insert+select sobre bitacora.transiciones (nunca
# update/delete — la inmutabilidad del audit log se impone a nivel de
# permisos de base, no solo por convención de código) y poner acá su
# connection string. La comparten gateway, orchestrator y los 3
# microservicios + sus workers — todos los que llaman set_estado().
AUDIT_DATABASE_URL=postgresql://bitacora_role.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
