# Fase 1: store real en Postgres (app/store.py) — correr primero
# services/risk-service/schema.sql contra este proyecto de Supabase.
# app/store.py referencia las tablas ya calificadas como `risk.limites` /
# `risk.evaluaciones` / `risk.acumulado_diario`, así que el DATABASE_URL no
# necesita ningún parámetro de schema.
# Usar el "Connection pooling" (Transaction pooler, puerto 6543) del
# dashboard de Supabase, NO la conexión directa "db.xxxxx.supabase.co" —
# esa resuelve solo a IPv6 y falla desde dentro de Docker Desktop. El
# usuario del pooler es postgres.<project-ref>, no solo "postgres".
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
